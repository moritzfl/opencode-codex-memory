# Live host checks (`bun run live:read`, `bun run live:e2e`).
# Copy to `.env` (gitignored). Never copy host OpenCode OAuth / sqlite.

OPENCODE_LIVE_BASE_URL=https://ollama.com/v1
OPENCODE_LIVE_MODEL=deepseek-v4.1-flash
# OPENCODE_LIVE_SMALL_MODEL=deepseek-v4.1-flash
OPENCODE_LIVE_API_KEY=

# No provider API key? Enable the local proxy in LLM Subscription Usage
# https://github.com/moritzfl/openai-usage-quota-intellij
# then paste Copy Base URL + Copy API Key:
# OPENCODE_LIVE_BASE_URL=http://127.0.0.1:<proxy-port>/v1
